{
  "name": "ozi-ui/core",
  "version": "2.7.0",
  "description": "UI components for Laravel and Livewire, configured in HTML: select, rich-text editor, form validation, AJAX forms. Plain JavaScript, zero dependencies.",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "livewire", "blade", "ui-components", "select", "wysiwyg", "form-validation", "vanilla-js", "ozi-ui"],
  "homepage": "https://oziui.com",
  "authors": [
    {
      "name": "Thomaz Ozi",
      "homepage": "https://github.com/thomaz-ozi",
      "role": "Author"
    },
    {
      "name": "Support",
      "email": "support@oziui.com",
      "homepage": "https://oziui.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "OziUI\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OziUI\\Core\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "OziUI\\Core\\OziCoreServiceProvider"
      ]
    }
  },
  "minimum-stability": "alpha",
  "prefer-stable": true
}
